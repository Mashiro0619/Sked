  "privacyPolicyAcceptedVersionLabel": "Accepted version: {version}",
  "@privacyPolicyAcceptedVersionLabel": {
    "placeholders": {
      "version": {}
    }
  },
  "privacyPolicyIntro": "Sked is a local-first timetable tool. Timetables, general schedules, period-time sets, and school-site configuration are stored only on your device or in your browser, and are never automatically uploaded. The app only processes data when you explicitly trigger actions such as import, timetable text / HTML parsing, school webpage import, sharing, or opening external links. The full privacy policy is available online.",
  "@privacyPolicyIntro": {},
  "privacyPolicyLocalStorageTitle": "Local storage",
  "@privacyPolicyLocalStorageTitle": {},
  "privacyPolicyLocalStorageBody": "On native platforms, Sked stores timetable data, general schedules, related settings, and editable school-site configuration in the operating system's application-support directory; browser builds use browser storage. Files written by earlier versions to the user Documents directory remain in place, but they are not read or migrated automatically. To retain that data, export a full app backup from the old version before upgrading, then restore it afterward. AI API settings are stored locally; the custom API key is stored through the platform secure-storage layer when available. Full app backups do not include the custom API key. The app does not automatically upload this local data to a developer-controlled server.",
  "@privacyPolicyLocalStorageBody": {},
  "privacyPolicyImportExportTitle": "Import and export",
  "@privacyPolicyImportExportTitle": {},
  "privacyPolicyImportExportBody": "The app reads or writes timetable JSON files, timetable JSON text, general schedule JSON / ICS files, full app backup JSON files, school-site JSON files, and period-template files only when you explicitly choose a file, paste JSON, or start an export action. Importing these files and JSON text is a local operation unless you also choose timetable text / HTML parsing or school webpage import. Fetching a custom model list is also an explicit network action and only contacts the custom endpoint you configured.",
  "@privacyPolicyImportExportBody": {},
  "privacyPolicySharingTitle": "Sharing",
  "@privacyPolicySharingTitle": {},
  "privacyPolicySharingBody": "When you explicitly use sharing, the app passes the exported file to the system share sheet or to the target app you choose. How that file is handled afterward depends on the target app or service you selected.",
  "@privacyPolicySharingBody": {},
  "privacyPolicyExternalLinksTitle": "External links",
  "@privacyPolicyExternalLinksTitle": {},
  "privacyPolicyExternalLinksBody": "When you open external links such as the GitHub repository, the app hands the action off to your browser or another external application. Data handling after that point is governed by the third party you open.",
  "@privacyPolicyExternalLinksBody": {},
  "privacyPolicyNoCollectionTitle": "What the app does not collect",
  "@privacyPolicyNoCollectionTitle": {},
  "privacyPolicyNoCollectionBody": "The app does not require a Sked account and does not enable analytics, advertising identifiers, or cloud backup. It also does not provide a dedicated field for collecting school account passwords. If you sign in to a school website inside the app, that interaction happens on the school page you opened.",
  "@privacyPolicyNoCollectionBody": {},
  "privacyPolicyFutureFeatureTitle": "Timetable text / HTML parsing",
  "@privacyPolicyFutureFeatureTitle": {},
  "privacyPolicyFutureFeatureBody": "When you use school webpage import or parse pasted timetable text / HTML, the app first prepares and cleans the content locally, then sends the submitted timetable text, page text or HTML content, optional page title and URL, the current app language, and parser prompt content to the OpenAI-compatible endpoint you configured. Fetching the model list also requests that same configured endpoint. Sked does not provide a built-in parser endpoint and does not send parsing requests to a developer-controlled timetable parser backend. The custom endpoint and any upstream services may store, forward, limit, delete, or otherwise process data according to the rules of the service provider you choose. If you use an http:// Base URL, only use it on trusted devices, trusted networks, and trusted endpoint services, because content and API keys may not be protected by transport encryption.",
  "@privacyPolicyFutureFeatureBody": {},
  "privacyPolicyUpdatesTitle": "Policy updates",
  "@privacyPolicyUpdatesTitle": {},
  "privacyPolicyUpdatesBody": "The current privacy policy version is {version}. If a later version changes how data is handled, the app may ask you to read and agree to the updated policy again.",
  "@privacyPolicyUpdatesBody": {
    "placeholders": {
      "version": {}
    }
  },
  "privacyGateTitle": "Please agree to the privacy policy before using the app",
  "@privacyGateTitle": {},
  "privacyGateSummaryStorage": "Timetables, general schedules, period-time sets, and school-site configuration are only stored locally and are not automatically uploaded to a developer server.",
  "@privacyGateSummaryStorage": {},
  "privacyGateSummaryImportExport": "Import, export, full backups, and sharing only happen when you explicitly start them; full app backups exclude custom API keys, and timetable text / HTML parsing only sends submitted content to your configured parser endpoint.",
  "@privacyGateSummaryImportExport": {},
  "privacyGateSummaryUpdates": "If a later version changes how data is handled, the app may ask you to review the updated privacy policy again.",
  "@privacyGateSummaryUpdates": {},
