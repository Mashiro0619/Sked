  "privacyPolicyTitle": "Privacy Policy",
  "@privacyPolicyTitle": {},
  "privacyPolicyEntryDesc": "Learn how the app handles local storage, school-site configuration, file import/export, webpage parsing, and external links.",
  "@privacyPolicyEntryDesc": {},
  "privacyPolicyAcceptedVersionLabel": "Accepted version: {version}",
  "@privacyPolicyAcceptedVersionLabel": {
    "placeholders": {
      "version": {}
    }
  },
  "privacyPolicyIntro": "Sked is een lokaal-eerst roosterhulpmiddel. Roosters, periodetijdsets en schoolwebsiteconfiguratie worden alleen op je apparaat of in je browser opgeslagen en worden nooit automatisch geüpload. De app verwerkt alleen gegevens wanneer je expliciet acties start zoals importeren, webpagina-analyse, delen of het openen van externe links. Het volledige privacybeleid is online beschikbaar.",
  "@privacyPolicyIntro": {},
  "privacyPolicyLocalStorageTitle": "Local storage",
  "@privacyPolicyLocalStorageTitle": {},
  "privacyPolicyLocalStorageBody": "Timetable data and related settings are stored in a local file named Sked_data.json inside the app documents directory. Editable school-site configuration is stored separately in Sked_school_sites.json. Custom timetable parser settings are stored locally; the custom API key is stored through the platform secure-storage layer when available. When used in a browser, the same kinds of data are stored in browser storage. The app does not automatically upload this local data to a developer-controlled server.",
  "@privacyPolicyLocalStorageBody": {},
  "privacyPolicyImportExportTitle": "Import and export",
  "@privacyPolicyImportExportTitle": {},
  "privacyPolicyImportExportBody": "The app reads or writes timetable JSON files, school-site JSON files, and period-template files only when you explicitly choose a file or start an export action. Importing these files is a local operation unless you also choose webpage parsing. Fetching a custom model list is also an explicit network action and only contacts the custom endpoint you configured.",
  "@privacyPolicyImportExportBody": {},
  "privacyPolicySharingTitle": "Sharing",
  "@privacyPolicySharingTitle": {},
  "privacyPolicySharingBody": "When you explicitly use sharing, the app passes the exported file to the system share sheet or to the target app you choose. How that file is handled afterward depends on the target app or service you selected.",
  "@privacyPolicySharingBody": {},
  "privacyPolicyExternalLinksTitle": "External links",
  "@privacyPolicyExternalLinksTitle": {},
  "privacyPolicyExternalLinksBody": "When you open external links such as the GitHub repository, the app hands the action off to your browser or another external application. Data handling after that point is governed by the third party you open.",
  "@privacyPolicyExternalLinksBody": {},
  "privacyPolicyNoCollectionTitle": "What the app does not collect",
  "@privacyPolicyNoCollectionTitle": {},
  "privacyPolicyNoCollectionBody": "The app does not require a Sked account and does not enable analytics, advertising identifiers, or cloud backup. It also does not provide a dedicated field for collecting school account passwords. If you sign in to a school website inside the app, that interaction happens on the school page you opened.",
  "@privacyPolicyNoCollectionBody": {},
  "privacyPolicyFutureFeatureTitle": "Webpage parsing",
  "@privacyPolicyFutureFeatureTitle": {},
  "privacyPolicyFutureFeatureBody": "When you use school webpage import or paste HTML for parsing, the app first compresses and cleans the content locally, then sends the submitted page content, optional page title and URL, the current app language, and parser prompt content to the OpenAI-compatible endpoint you configured. Fetching the model list also requests that same configured endpoint. Sked does not provide a built-in parser endpoint and does not send parsing requests to a developer-controlled timetable parser backend. The custom endpoint and any upstream services may store, forward, limit, delete, or otherwise process data according to the rules of the service provider you choose. If you use an http:// Base URL, submitted content and API keys may not be protected by transport encryption.",
  "@privacyPolicyFutureFeatureBody": {},
  "privacyPolicyUpdatesTitle": "Policy updates",
  "@privacyPolicyUpdatesTitle": {},
  "privacyPolicyUpdatesBody": "The current privacy policy version is {version}. If a later version changes how data is handled, the app may ask you to read and agree to the updated policy again.",
  "@privacyPolicyUpdatesBody": {
    "placeholders": {
      "version": {}
    }
  },
  "privacyGateTitle": "Please agree to the privacy policy before using the app",
  "@privacyGateTitle": {},
  "privacyGateSummaryStorage": "Timetables, period-time sets, and school-site configuration are only stored locally and are not automatically uploaded to a developer server.",
  "@privacyGateSummaryStorage": {},
  "privacyGateSummaryImportExport": "Import, export, and sharing only happen when you explicitly start them; webpage parsing sends only the compressed content you submit to your configured parsing endpoint, and you can review the parsed timetable before saving.",
  "@privacyGateSummaryImportExport": {},
  "privacyGateSummaryUpdates": "If a later version changes how data is handled, the app may ask you to review the updated privacy policy again.",
  "@privacyGateSummaryUpdates": {},
